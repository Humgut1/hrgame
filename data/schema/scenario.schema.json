{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrgame.local/schema/scenario.schema.json",
  "title": "Scenario",
  "description": "스테이지 1건. 시나리오 추가는 콘텐츠 작업이어야 하므로 진행 국면·NPC·문서·폼·채점 기준이 전부 여기 들어간다. 코드는 이 파일을 해석만 한다.",
  "type": "object",
  "required": [
    "id", "schemaVersion", "track", "title", "companyId", "today",
    "player", "clock", "phases", "briefing", "npcDirection", "npcs",
    "documents", "offerForm", "scoring", "aar"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "track": {
      "type": "object",
      "required": ["id", "name", "stage"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "enum": ["recruit", "hr-ops", "compensation", "labor", "er"] },
        "name": { "type": "string" },
        "stage": { "type": "integer", "minimum": 1 }
      }
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "companyId": { "type": "string", "description": "data/companies/<id>.json 참조" },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "게임 내 오늘. 문서·NPC 대사의 날짜 계산 기준."
    },
    "player": {
      "type": "object",
      "required": ["name", "team", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "team": { "type": "string" },
        "role": { "type": "string" },
        "tenure": { "type": "string" },
        "addressedAs": { "type": "string", "description": "NPC가 부르는 호칭. 예: \"승헌님\"" }
      }
    },
    "clock": {
      "type": "object",
      "required": ["startTime", "deadlineTime", "minutesPerMessage", "maxTurns"],
      "additionalProperties": false,
      "description": "턴 = 플레이어가 NPC에게 보내는 메시지 1건. 상태머신이 소유한다.",
      "properties": {
        "startTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "deadlineTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "deadlineLabel": { "type": "string" },
        "minutesPerMessage": { "type": "integer", "minimum": 1 },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "documentReadCostsTurn": {
          "type": "boolean",
          "description": "자료 열람이 턴을 소모하는가. false면 조사는 자유, 대화만 시간을 쓴다."
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "description": "상태머신이 강제하는 국면 순서. LLM은 국면을 바꿀 수 없다.",
      "items": {
        "type": "object",
        "required": ["id", "name", "allows"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["briefing", "investigate", "decision", "result", "debrief"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "allows": {
            "type": "array",
            "items": { "type": "string", "enum": ["read_documents", "message_npc", "submit_offer", "view_report"] }
          },
          "advanceOn": {
            "type": "string",
            "enum": ["acknowledge", "player_action", "turns_exhausted_or_submit", "submit_offer", "grade_complete"]
          }
        }
      }
    },
    "briefing": {
      "type": "object",
      "required": ["headline", "situation", "objective"],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string" },
        "situation": { "type": "array", "items": { "type": "string" } },
        "objective": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "candidate": {
      "type": "object",
      "description": "채용 트랙 전용 확장. 다른 트랙에서는 생략된다.",
      "additionalProperties": true
    },
    "position": {
      "type": "object",
      "description": "채용 트랙 전용 확장.",
      "additionalProperties": true
    },
    "npcDirection": {
      "type": "object",
      "required": ["rules", "trustRules"],
      "description": "LLM 프롬프트에 반드시 그대로 삽입되는 연기 규칙.",
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "trustBehavior": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["below", "behavior"],
            "additionalProperties": false,
            "properties": {
              "atLeast": { "type": "integer" },
              "below": { "type": "integer" },
              "behavior": { "type": "string" }
            }
          }
        },
        "trustRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["when", "delta"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string" },
              "delta": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "title", "initialTrust", "persona", "openingMessage"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "age": { "type": "integer" },
          "avatar": { "type": "string" },
          "relationToPlayer": { "type": "string" },
          "initialTrust": { "type": "integer", "minimum": 0, "maximum": 100 },
          "persona": {
            "type": "object",
            "required": ["voice", "goal"],
            "additionalProperties": false,
            "properties": {
              "voice": { "type": "string", "description": "말투. 프롬프트에 그대로 들어간다." },
              "goal": { "type": "string" },
              "pressureTactic": { "type": "string" },
              "hiddenCircumstance": { "type": "string", "description": "먼저 말하지 않는다. 물어야 나온다." }
            }
          },
          "knows": { "type": "array", "items": { "type": "string" } },
          "doesNotKnow": {
            "type": "array",
            "items": { "type": "string" },
            "description": "모른다고 답해야 하는 것. 여기에 없다고 아무거나 지어내면 안 된다."
          },
          "dataAccess": {
            "type": "array",
            "items": { "type": "string" },
            "description": "이 NPC의 프롬프트에 실어 줄 회사 마스터 데이터의 점 경로. 예: \"compensation.bands\". 여기 없는 데이터는 프롬프트에 아예 들어가지 않으므로 NPC가 인용할 수 없다."
          },
          "openingMessage": { "type": "string" },
          "secrets": {
            "type": "array",
            "description": "숨은 정보. 그 주제를 구체적으로 물었을 때만 흘린다.",
            "items": {
              "type": "object",
              "required": ["id", "topic", "content", "revealWhen"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "topic": { "type": "string" },
                "content": { "type": "string" },
                "importance": { "type": "string", "enum": ["critical", "helpful"] },
                "unlocks": { "type": "string", "description": "이 정보가 열어주는 선택지" },
                "revealWhen": {
                  "type": "object",
                  "required": ["requiresSpecificQuestion", "keywords", "minTrust"],
                  "additionalProperties": false,
                  "properties": {
                    "requiresSpecificQuestion": { "type": "boolean" },
                    "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                    "minTrust": { "type": "integer", "minimum": 0, "maximum": 100 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "description": "자료실. 열람 여부를 추적해 데이터 근거성 채점에 반영한다.",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "blocks"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "issuedAt": { "type": "string" },
          "summary": { "type": "string" },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "oneOf": [
                {
                  "properties": {
                    "type": { "const": "text" },
                    "heading": { "type": "string" },
                    "text": { "type": "string" }
                  },
                  "required": ["type", "text"],
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "type": { "const": "fields" },
                    "heading": { "type": "string" },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "additionalProperties": false,
                        "properties": {
                          "label": { "type": "string" },
                          "value": { "type": "string" },
                          "emphasis": { "type": "boolean" }
                        }
                      }
                    }
                  },
                  "required": ["type", "items"],
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "type": { "const": "table" },
                    "heading": { "type": "string" },
                    "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "array", "items": { "type": "string" } }
                    }
                  },
                  "required": ["type", "columns", "rows"],
                  "additionalProperties": false
                },
                {
                  "description": "회사 마스터 데이터를 경로로 참조해 표로 렌더한다. 급여·밴드·재직자의 진실은 회사 JSON에만 둔다.",
                  "properties": {
                    "type": { "const": "companyTable" },
                    "heading": { "type": "string" },
                    "ref": { "type": "string", "description": "예: compensation.bands, employees" },
                    "filter": { "type": "object", "additionalProperties": { "type": "string" } },
                    "columns": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["key", "label"],
                        "additionalProperties": false,
                        "properties": {
                          "key": { "type": "string" },
                          "label": { "type": "string" },
                          "format": { "type": "string", "enum": ["text", "number", "range"] },
                          "rangeWith": { "type": "string", "description": "format=range일 때 짝이 되는 키" }
                        }
                      }
                    }
                  },
                  "required": ["type", "ref", "columns"],
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "type": { "const": "note" },
                    "text": { "type": "string" }
                  },
                  "required": ["type", "text"],
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    },
    "offerForm": {
      "type": "object",
      "required": ["title", "irreversible", "fields"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "irreversible": { "type": "boolean" },
        "confirmText": { "type": "string" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "type", "required"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" },
              "label": { "type": "string" },
              "type": { "type": "string", "enum": ["number", "boolean", "textarea"] },
              "unit": { "type": "string" },
              "required": { "type": "boolean" },
              "min": { "type": "integer" },
              "max": { "type": "integer" },
              "minLength": { "type": "integer" },
              "placeholder": { "type": "string" },
              "help": { "type": "string" }
            }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["axes", "strictness"],
      "additionalProperties": false,
      "properties": {
        "strictness": { "type": "string" },
        "rubricBands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["min", "label", "meaning"],
            "additionalProperties": false,
            "properties": {
              "min": { "type": "integer" },
              "label": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "criteria"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "name": { "type": "string" },
              "criteria": { "type": "string" },
              "weight": { "type": "number", "minimum": 0 },
              "looksLike": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "high": { "type": "array", "items": { "type": "string" } },
                  "low": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "modelSolution": {
          "type": "object",
          "required": ["summary"],
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "string" },
            "components": { "type": "array", "items": { "type": "string" } },
            "rationale": { "type": "string" },
            "disclaimer": { "type": "string" }
          }
        },
        "penalties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when", "effect"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "when": { "type": "string" },
              "effect": { "type": "string" },
              "axisId": { "type": "string" },
              "capAt": { "type": "integer", "minimum": 0, "maximum": 100 },
              "detect": {
                "type": "object",
                "description": "코드가 결정론적으로 판정하는 규칙. 생략하면 채점 LLM이 판정한다(문장 이해가 필요한 경우). 임계값은 회사 마스터 데이터에서 읽으므로 여기 숫자를 적지 않는다.",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "booleanField",
                      "exceedsBandMax",
                      "exceedsApprovalLimit",
                      "noDocumentsRead",
                      "singleNpcOnly"
                    ]
                  },
                  "field": { "type": "string", "description": "offerForm.fields[].id" },
                  "approvalId": {
                    "type": "string",
                    "description": "company.compensation.approvals[].id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "aar": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "kind"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "title": { "type": "string" },
              "kind": { "type": "string", "enum": ["outcome", "scores", "prose", "bullets", "timeline"] },
              "instruction": { "type": "string", "description": "채점 LLM에게 주는 생성 지시" },
              "bulletCount": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "outcomeOptions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
